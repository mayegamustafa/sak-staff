# Settings for docker-compose.yml. On the server: copy to .env.docker,
# fill in, then `chmod 600 .env.docker`. Never commit .env.docker.
#
# Generate each secret on the server with:   openssl rand -hex 32
# (hex keeps the database password safe to embed in a connection URL)

DB_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Public hostname, without https:// – its DNS A record must point at this server.
DOMAIN=staff.saktech.org

# Extra browser origins allowed to call the API (the app's own origin is always
# allowed). Comma-separated; wildcards like https://*.example.org are supported.
CORS_ORIGINS=

# FIRST INSTALL ON AN EMPTY DATABASE ONLY: initial superadmin password used by
# `npm run seed`. Leave empty to have one generated and printed. Never run the
# seed when you have restored your existing data.
SEED_ADMIN_PASSWORD=
