# ─────────────────────────────────────────────
# SAK Staff Backend – Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# ── Database ─────────────────────────────────
# Either set DATABASE_URL (managed hosts: Railway, Render, Neon, Fly)...
# DATABASE_URL=postgres://user:password@host:5432/sak_staff
# ...or the discrete settings below (self-hosted).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sak_staff
DB_USER=sak_admin
DB_PASSWORD=your_secure_password_here
# TLS to Postgres: auto (default) = on for remote hosts, off for localhost/*.internal
DB_SSL=auto

# ── JWT ──────────────────────────────────────
# REQUIRED in production: at least 32 random characters each, and different.
# The server refuses to start with a placeholder value when NODE_ENV=production.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d

# ── File uploads ─────────────────────────────
# On a hosted platform this MUST point at a mounted volume, or every uploaded
# document is destroyed on the next deploy.
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ── CORS – extra allowed browser origins ─────
# The app's own origin and PUBLIC_URL are always allowed. Comma-separated;
# wildcards such as https://*.example.org are supported. Nothing else is trusted.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Public URL (used to build onboarding links) ──
# PUBLIC_URL=https://staff.example.org

# ── Reverse proxy ────────────────────────────
# Number of proxy hops in front of the app (cloudflared/nginx/Railway = 1).
# Without this, rate limiting treats the entire school as a single client.
TRUST_PROXY=1

# ── Rate limiting ────────────────────────────
# Requests per IP per 15 minutes.
RATE_LIMIT_MAX=600
# Consecutive failed logins before an ACCOUNT is locked (stored in the database,
# so it holds across restarts and multiple instances). An admin "reset password"
# unlocks it early.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_LOCK_MINUTES=15
# Failed logins per client IP per 15 minutes across all usernames (anti-spraying).
LOGIN_IP_RATE_LIMIT_MAX=50
# Public onboarding form submissions per IP per hour.
ONBOARDING_RATE_LIMIT_MAX=30

# ── First-run admin ──────────────────────────
# Password for the seeded "superadmin" account. If empty, the seed generates a
# random one and prints it. Either way it must be changed at first sign-in.
# SEED_ADMIN_PASSWORD=

# ── Logging ──────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs
# Write log files as well as stdout. Leave off on managed platforms.
# LOG_TO_FILE=true

# ── Paths (only if not using the standard monorepo / Docker layout) ──
# FRONTEND_DIST=/srv/sak/desktop-dist
# DOWNLOADS_DIR=/srv/sak/downloads
# Max JSON / form body size (signatures and photos are sent as base64)
# BODY_LIMIT=20mb

# ── Content-Security-Policy (opt-in) ─────────
# Test in staging before enabling: the SPA must load with no console errors.
# ENABLE_CSP=true
